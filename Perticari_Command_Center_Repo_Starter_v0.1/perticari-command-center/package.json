{
  "name": "perticari-command-center",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --local --local-protocol https",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "npm run build && node test/browser.cjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.57.0",
    "wrangler": "4.150.0"
  }
}
